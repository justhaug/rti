# Runs ON the oracle pod (systemd or supervisord inside the Runpod desktop).
# Stops the pod itself when RTI has not sent a heartbeat for WATCHDOG_IDLE_MINUTES.
[Unit]
Description=RTI oracle pod shutdown watchdog
After=network-online.target

[Service]
Type=simple
Environment=WATCHDOG_PORT=27016
Environment=WATCHDOG_IDLE_MINUTES=10
Environment=WATCHDOG_BOOT_GRACE_MINUTES=15
EnvironmentFile=-/etc/rti/oracle-env
ExecStart=/usr/local/bin/rti-oracle-watchdog
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
